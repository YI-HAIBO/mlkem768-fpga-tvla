## Nexys 4 DDR Pin Constraints for ipx_aoi_sec_nexys_top
## Board: Digilent Nexys 4 DDR (Artix-7 XC7A100T-1CSG324)
## Created: 2026-10-07

# === 100 MHz Clock ===
set_property PACKAGE_PIN E3 [get_ports clk]
set_property IOSTANDARD LVCMOS33 [get_ports clk]
create_clock -name clk -period 10.000 [get_ports clk] -waveform {0.000 5.000}

# === CPU Reset (active low) ===
set_property PACKAGE_PIN C12 [get_ports rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports rst_n]

# === 16 User LEDs ===
set_property PACKAGE_PIN H17 [get_ports test_led[0]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[0]]
set_property PACKAGE_PIN K15 [get_ports test_led[1]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[1]]
set_property PACKAGE_PIN J13 [get_ports test_led[2]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[2]]
set_property PACKAGE_PIN N14 [get_ports test_led[3]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[3]]
set_property PACKAGE_PIN R18 [get_ports test_led[4]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[4]]
set_property PACKAGE_PIN V17 [get_ports test_led[5]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[5]]
set_property PACKAGE_PIN U17 [get_ports test_led[6]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[6]]
set_property PACKAGE_PIN U16 [get_ports test_led[7]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[7]]
set_property PACKAGE_PIN V16 [get_ports test_led[8]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[8]]
set_property PACKAGE_PIN T15 [get_ports test_led[9]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[9]]
set_property PACKAGE_PIN U14 [get_ports test_led[10]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[10]]
set_property PACKAGE_PIN T16 [get_ports test_led[11]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[11]]
set_property PACKAGE_PIN V15 [get_ports test_led[12]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[12]]
set_property PACKAGE_PIN V14 [get_ports test_led[13]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[13]]
set_property PACKAGE_PIN V12 [get_ports test_led[14]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[14]]
set_property PACKAGE_PIN V11 [get_ports test_led[15]]
set_property IOSTANDARD LVCMOS33 [get_ports test_led[15]]

# === 16 Slide Switches ===
set_property PACKAGE_PIN J15 [get_ports test_sw[0]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[0]]
set_property PACKAGE_PIN L16 [get_ports test_sw[1]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[1]]
set_property PACKAGE_PIN M13 [get_ports test_sw[2]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[2]]
set_property PACKAGE_PIN R15 [get_ports test_sw[3]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[3]]
set_property PACKAGE_PIN R17 [get_ports test_sw[4]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[4]]
set_property PACKAGE_PIN T18 [get_ports test_sw[5]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[5]]
set_property PACKAGE_PIN U18 [get_ports test_sw[6]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[6]]
set_property PACKAGE_PIN R13 [get_ports test_sw[7]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[7]]
set_property PACKAGE_PIN T8  [get_ports test_sw[8]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[8]]
set_property PACKAGE_PIN U8  [get_ports test_sw[9]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[9]]
set_property PACKAGE_PIN R16 [get_ports test_sw[10]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[10]]
set_property PACKAGE_PIN T13 [get_ports test_sw[11]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[11]]
set_property PACKAGE_PIN H6  [get_ports test_sw[12]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[12]]
set_property PACKAGE_PIN U12 [get_ports test_sw[13]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[13]]
set_property PACKAGE_PIN U11 [get_ports test_sw[14]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[14]]
set_property PACKAGE_PIN V10 [get_ports test_sw[15]]
set_property IOSTANDARD LVCMOS33 [get_ports test_sw[15]]

# === 5 Push Buttons ===
set_property PACKAGE_PIN N17 [get_ports test_btn[0]]
set_property IOSTANDARD LVCMOS33 [get_ports test_btn[0]]
set_property PACKAGE_PIN P17 [get_ports test_btn[1]]
set_property IOSTANDARD LVCMOS33 [get_ports test_btn[1]]
set_property PACKAGE_PIN M17 [get_ports test_btn[2]]
set_property IOSTANDARD LVCMOS33 [get_ports test_btn[2]]
set_property PACKAGE_PIN M18 [get_ports test_btn[3]]
set_property IOSTANDARD LVCMOS33 [get_ports test_btn[3]]
set_property PACKAGE_PIN P18 [get_ports test_btn[4]]
set_property IOSTANDARD LVCMOS33 [get_ports test_btn[4]]

# === Clock Uncertainty ===
set_clock_uncertainty 0.300 [get_ports clk]