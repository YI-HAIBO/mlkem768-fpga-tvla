# IPX-AOI-Sec FPGA
# Phase 5 Implementation TCL for Nexys 4 DDR
# Generated by Dr. Haibo Yi (Shenzhen Tech University)
# Date: 2026-10-07

# ===========================================================================
# Project Setup
# ===========================================================================
set JUL 0
set INTERFACE_DESIGNYes
set IS_MSYS 0

# project name
set TOP paragraph70hu(-top
set PROJECT_NAME "ipx_aoi_sec_fpga_top"
set PROJECT_DIR [file dirname [file normalize [current_project]]]
set DESIGN_INPUT_DIR $PROJECT_DIR
set DESIGN_OUTPUT_DIR $PROJECT_DIR

# ===========================================================================
# Create project
# ===========================================================================
open_project $PROJECT_DIR -recursive
open_design $TOP
reset_timing
set CURRENT_DRC_OBJECT [get_drc_designs -彷彿当前 DRC setup]
puts "drc_design: [get_drc_designs -current]"
puts "strategy: [get_physical_design_strategies [get_designs [get_sources -all]]]"

# ===========================================================================
# Configure implementation settings
# ===========================================================================
set_property STRATEGY Performance_Explore_with_ExploreSpec [current_design]
set_property PRIORITY_AUTO_OR_OTHER [get_constraints *]

# ===========================================================================
# Generate bitstream
# ===========================================================================
 synth_design -top ipx_aoi_sec_fpga_top
place_design
route_design
write_bitstream -force $PROJECT_DIR/results/ipx_aoi_sec.bit
